        "# 1. Import necessary libraries\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import os\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# 2. Setup synthetic 10k data generation to replicate your specific notebook data\n",
        "np.random.seed(42)\n",
        "n_records = 10000\n",
        "\n",
        "data = {\n",
        "    'transaction_id': range(100001, 100001 + n_records),\n",
        "    'amount': np.random.exponential(scale=120, size=n_records).round(2),\n",
        "    'transaction_hour': np.random.randint(0, 24, size=n_records),\n",
        "    'device_trust_score': np.random.randint(20, 100, size=n_records),\n",
        "    'velocity_last_24h': np.random.randint(1, 15, size=n_records),\n",
        "    'foreign_transaction': np.random.choice([0, 1], size=n_records, p=[0.88, 0.12]),\n",
        "    'location_mismatch': np.random.choice([0, 1], size=n_records, p=[0.93, 0.07]),\n",
        "    'merchant_category': np.random.choice(['Online Retail', 'Gas Station', 'Groceries', 'Electronics', 'Travel', 'Entertainment'], size=n_records)\n",
        "}\n",
        "\n",
        "# Generate Target Flag ('is_fraud') based on high-risk features\n",
        "df_sim = pd.DataFrame(data)\n",
        "fraud_prob = (df_sim['foreign_transaction'] * 0.3) + (df_sim['location_mismatch'] * 0.4) + (df_sim['amount'] > 400).astype(int) * 0.2\n",
        "df_sim['is_fraud'] = np.where(fraud_prob + np.random.rand(n_records) > 0.85, 1, 0)\n",
        "\n",
        "# Save it as the exact file your notebook looks for\n",
        "df_sim.to_csv(\"credit_card_fraud_10k.csv\", index=False)\n",
        "print(\"✅ Environment successfully prepared! 'credit_card_fraud_10k.csv' created.\")"
      ]
    },
