    {
      "cell_type": "code",
      "source": [
        "df2 = df.copy()\n",
        "\n",
        "# Establish outlier thresholds\n",
        "vel_thr = df2[\"velocity_last_24h\"].quantile(0.9)\n",
        "trust_thr = df2[\"device_trust_score\"].quantile(0.1)\n",
        "\n",
        "# Build Risk Score Framework\n",
        "df2[\"risk_score\"] = 0\n",
        "df2[\"risk_score\"] += (df2[\"foreign_transaction\"] == 1).astype(int)\n",
        "df2[\"risk_score\"] += (df2[\"location_mismatch\"] == 1).astype(int)\n",
        "df2[\"risk_score\"] += (df2[\"velocity_last_24h\"] >= vel_thr).astype(int)\n",
        "df2[\"risk_score\"] += (df2[\"device_trust_score\"] <= trust_thr).astype(int)\n",
        "\n",
        "# Group risk results\n",
        "risk_analysis = df2.groupby(\"risk_score\")[\"is_fraud\"].mean() * 100\n",
        "print(\"--- Fraud Rate Based on Multiplied Risk Indicators ---\")\n",
        "print(risk_analysis.round(2))\n",
        "\n",
        "# Visualize Risk Escalation Matrix\n",
        "plt.figure(figsize=(6,3.5))\n",
        "risk_analysis.plot(kind=\"bar\", color=\"orange\", edgecolor=\"darkorange\")\n",
        "plt.title(\"Risk Matrix Escalation vs Verified Fraud Outcomes\")\n",
        "plt.xlabel(\"Number of Risk Flags Triggered (0 to 4)\")\n",
        "plt.ylabel(\"Actual Fraud Frequency %\")\n",
        "plt.grid(axis='y', alpha=0.3)\n",
        "plt.show()"
